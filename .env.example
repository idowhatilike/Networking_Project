# OGK-Server Configuration
OGK_SERVER_HOST=0.0.0.0
OGK_SERVER_PORT=8443
OGK_DB_URL=sqlite:///./ogk_server.db

# Cryptographic Keys (Generate random 32-byte hex/base64 before running in lab)
OGK_POLICY_HMAC_SECRET=replace_with_32_byte_hex_secret_in_env
